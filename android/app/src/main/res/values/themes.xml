<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark launch window so the first frame does not flash white on slow devices. -->
    <style name="Theme.ManHunt" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launch_bg</item>
        <item name="android:navigationBarColor">@color/launch_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
